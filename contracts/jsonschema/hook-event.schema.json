{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zbot hook stdin event v1",
  "x-spec": [
    "docs/specs/external-hooks/"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "event_id",
    "invocation_id",
    "session_id",
    "agent_id",
    "run_id",
    "turn_id",
    "tool_call_id",
    "event",
    "occurred_at",
    "data"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "turn_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "tool_call_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "event": {
      "enum": [
        "session_start",
        "user_prompt",
        "run_start",
        "run_end",
        "before_model",
        "after_model",
        "before_tool",
        "after_tool",
        "invalid_tool_call"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object"
    }
  },
  "$comment": "Serialized stdin must be <=64 KiB UTF-8. IDs are authoritative server values; run/turn/tool IDs are null before they exist. No prompts/system instructions/recall are included except current user_prompt. Tool arguments use the spec\u2019s recursive key/container and registered-secret-value projection, with arguments_redacted flag; no provider/MCP config or tool result content is sent. Event legality and byte limits also require runtime checks.",
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "session_start"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "user_prompt"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prompt"
            ],
            "properties": {
              "prompt": {
                "type": "string",
                "maxLength": 16384
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "run_start"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "chat",
                  "research"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "run_end"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "completed",
                  "failed",
                  "blocked",
                  "cancelled"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "before_model"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "model"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "after_model"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "model",
              "status"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "status": {
                "enum": [
                  "completed",
                  "failed",
                  "cancelled"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "before_tool"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "arguments",
              "arguments_redacted"
            ],
            "properties": {
              "tool": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "arguments": {
                "type": "object"
              },
              "arguments_redacted": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "after_tool"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "status"
            ],
            "properties": {
              "tool": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "status": {
                "enum": [
                  "completed",
                  "failed",
                  "cancelled"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "invalid_tool_call"
          }
        },
        "required": [
          "event"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "error"
            ],
            "properties": {
              "tool": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 128
              },
              "error": {
                "enum": [
                  "unknown_tool",
                  "invalid_arguments",
                  "policy_denied"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
